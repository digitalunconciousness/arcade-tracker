# Only what the app needs goes into the image: no history, data, secrets or development files.
.git/
.github/
.claude/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Data and secrets: never in an image.
.env
.env.*
!.env.example
*.db
*.sqlite3
instance/
uploads/
backups/
logs/
static/maintenance_photos/
static/profile_pics/

# Not needed to run it.
tests/
docs/
Dockerfile
docker-compose.yml
.dockerignore
