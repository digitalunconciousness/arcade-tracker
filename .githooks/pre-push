#!/usr/bin/env bash
# Refuse a push that would publish private values. The checks are scripts/privacy_check.sh,
# the same one run by hand before a push; this hook runs it over exactly what each pushed
# ref adds to the remote. Enabled per clone with:
#
#     git config core.hooksPath .githooks
#
# The repository is public: anything pushed is published, and history keeps it after a
# delete. Without an owner patterns file the check fails, and so does the push.
set -u

readonly ZERO=0000000000000000000000000000000000000000
ROOT=$(git rev-parse --show-toplevel) || exit 1
fail=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue                  # deleting a branch: nothing to check
  if [ "$remote_sha" = "$ZERO" ]; then
    range=("$local_sha" --not --remotes)                    # new branch: what the remote lacks
  else
    range=("$remote_sha..$local_sha")
  fi
  "$ROOT/scripts/privacy_check.sh" "${range[@]}" >&2 || fail=1
done

if [ "$fail" -ne 0 ]; then
  printf '\npre-push: REFUSED. Fix the commits; nothing was sent.\n' >&2
  exit 1
fi
exit 0
