# Cabcrawl Environment Variables
# Copy this file to .env and fill in your values.
#
# Every setting is checked when the app starts (app/config.py). A value it can't run with
# stops it with a list of every problem; check before restarting with
#   python scripts/check_config.py
# deploy.sh runs that check itself, before it migrates or restarts anything.
# Values still reading "your-...-here" count as unset.

# Cloud Storage (optional): a backup copy of each work-order photo in S3. Photos are always
# served from this server. On without all three AWS values, it stays off (with a warning).
USE_CLOUD_STORAGE=false
AWS_ACCESS_KEY_ID=your-aws-access-key-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-key-here
AWS_BUCKET_NAME=your-unique-bucket-name
AWS_REGION=us-east-1

# Database (optional; SQLite in instance/ by default). PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@host/arcade_tracker

# Public base URL baked into printed QR machine labels.
#
# SET THIS BEFORE PRINTING ANY LABEL. A QR code is permanent: whatever host it
# encodes is the host it will still be asking for in two years. Unset, the label
# takes the host of the browser that printed it -- so a label printed over the LAN
# encodes a LAN address and resolves to nothing from a phone on cellular, which is
# the scan that matters when you are standing at a cabinet.
#
# Use the address that works from everywhere: the public hostname, not a private
# one. (GATBOX does not care either way -- it reads only the slug out of the URL
# and never checks the host.)
# BASE_URL=https://tracker.example.com

# Where the footer's "Source code" link points (AGPL-3.0 section 13). If you run a
# modified version, point it at your copy of the source.
# SOURCE_URL=https://github.com/digitalunconciousness/arcade-tracker

# Log level for the journal: INFO (default; every request and security event) or WARNING
# (problems only). See deploy/RUNBOOK.md, "Reading the logs".
# LOG_LEVEL=INFO

# Required. Signs sessions: the app won't start without it, and changing it signs everyone
# out. Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this-for-production

# Photo limits (optional): per work order, and for the whole photo folder.
MAX_PHOTOS_PER_RECORD=10
MAX_TOTAL_STORAGE_MB=500

# Shipment Tracking (Optional - for automatic tracking updates)
# Sign up at https://www.easypost.com/ for free tier (100 requests/month)
EASYPOST_API_KEY=your-easypost-api-key-here
