[Unit]
# Installed at /etc/systemd/system/arcade-tracker-alerts.service, started every minute by
# arcade-tracker-alerts.timer. Delivers alerts (feature step 6): scripts/send_alerts.py.
Description=Arcade Tracker: send alerts
Documentation=https://github.com/digitalunconciousness/arcade-tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=arcade-tracker
Group=arcade-tracker
WorkingDirectory=/opt/arcade-tracker
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/arcade-tracker-venv/bin/python scripts/send_alerts.py
# A send has a 10-second timeout and a run sends at most 200; stop a run that hangs anyway.
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

# The same sandbox as the site (arcade-tracker.service). create_app makes its folders at
# startup, so the same paths have to be writable.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/opt/arcade-tracker/instance
ReadWritePaths=/opt/arcade-tracker/uploads
ReadWritePaths=/opt/arcade-tracker/backups
ReadWritePaths=/opt/arcade-tracker/logs
ReadWritePaths=/opt/arcade-tracker/static/maintenance_photos
ReadWritePaths=/opt/arcade-tracker/static/profile_pics
Environment=MPLCONFIGDIR=/tmp/matplotlib
