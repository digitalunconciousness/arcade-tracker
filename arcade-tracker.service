[Unit]
# Installed at /etc/systemd/system/arcade-tracker.service.
# The copy that used to be in this repo named a user and a home directory that
# the deployment never had; this one matches what actually runs.
Description=Arcade Tracker
Documentation=https://github.com/digitalunconciousness/arcade-tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# A dedicated account, not root: the service faces the internet through the
# Cloudflare tunnel, so a web-server bug should not land as root.
User=arcade-tracker
Group=arcade-tracker

WorkingDirectory=/opt/arcade-tracker

# The virtualenv lives OUTSIDE the checkout. It used to be ./venv, which git
# tracked, so untracking it would have deleted the running interpreter on the
# next pull. deploy/deploy.sh installs into this one.
Environment=PYTHONUNBUFFERED=1
# Loopback only unless the site file below says otherwise. The Cloudflare tunnel
# reaches the app on localhost, so this default is enough to serve the public
# site; a LAN address is added per-site, never committed here.
Environment=WAITRESS_LISTEN=--listen=127.0.0.1:5000
EnvironmentFile=-/etc/arcade-tracker/listen.conf

# waitress, not `flask run`: Werkzeug's development server is not for production
# and said so. $WAITRESS_LISTEN is deliberately unquoted so systemd splits it
# into separate --listen arguments.
ExecStart=/opt/arcade-tracker-venv/bin/waitress-serve $WAITRESS_LISTEN --call app:create_app

Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Sandboxing. ProtectSystem=strict makes the whole filesystem read-only except
# ReadWritePaths, so that list has to cover every directory the application
# writes. app/__init__.py:_create_directories creates six at startup -- instance,
# uploads, backups, logs, static/maintenance_photos, static/profile_pics -- and
# os.makedirs raises "Read-only file system" for any that is missing and not
# listed here, which kills the service before it binds.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/opt/arcade-tracker/instance
ReadWritePaths=/opt/arcade-tracker/uploads
ReadWritePaths=/opt/arcade-tracker/backups
ReadWritePaths=/opt/arcade-tracker/logs
ReadWritePaths=/opt/arcade-tracker/static/maintenance_photos
ReadWritePaths=/opt/arcade-tracker/static/profile_pics

# matplotlib wants a writable config/font-cache directory and falls back to $HOME,
# which ProtectHome=yes makes unavailable. Point it somewhere it can always write.
Environment=MPLCONFIGDIR=/tmp/matplotlib
CacheDirectory=arcade-tracker

[Install]
WantedBy=multi-user.target
